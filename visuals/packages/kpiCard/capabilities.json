{
  "dataRoles": [
    {
      "name": "value",
      "displayName": "Value",
      "kind": "Measure"
    },
    {
      "name": "target",
      "displayName": "Target",
      "kind": "Measure"
    },
    {
      "name": "comparison",
      "displayName": "Comparison (e.g. last year)",
      "kind": "Measure"
    },
    {
      "name": "axis",
      "displayName": "Sparkline axis",
      "kind": "Grouping"
    },
    {
      "name": "trend",
      "displayName": "Sparkline value",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "value": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "comparison": {
            "max": 1
          },
          "axis": {
            "max": 1
          },
          "trend": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "axis"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "value"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "comparison"
              }
            },
            {
              "for": {
                "in": "trend"
              }
            }
          ]
        }
      }
    }
  ],
