{
  "dataRoles": [
    {
      "name": "rows",
      "displayName": "Rows",
      "kind": "Grouping"
    },
    {
      "name": "columns",
      "displayName": "Columns",
      "kind": "Grouping"
    },
    {
      "name": "value",
      "displayName": "Value",
      "kind": "Measure"
    },
    {
      "name": "title",
      "displayName": "Dynamic title (text)",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "rows": {
            "max": 1
          },
          "columns": {
            "max": 1
          },
          "value": {
            "max": 1
          },
          "title": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "rows"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "group": {
            "by": "columns",
            "select": [
              {
                "for": {
                  "in": "value"
                }
              },
              {
                "for": {
                  "in": "title"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 200
              }
            }
          }
        }
      }
    }
  ],
  "objects": {
    "header": {
      "displayName": "Title",
      "properties": {
        "title": {
          "displayName": "Title",
          "type": {
            "text": true
          }
        },
        "subtitle": {
          "displayName": "Subtitle",
          "type": {
            "text": true
          }
        }
      }
    },
    "card": {
      "displayName": "Card",
      "properties": {
        "show": {
          "displayName": "Card background",
          "type": {
            "bool": true
          }
        }
      }
    },
    "colors": {
      "displayName": "Colors",
      "properties": {
        "primary": {
          "displayName": "Primary",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "primaryDark": {
          "displayName": "Primary (dark)",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "primaryLight": {
          "displayName": "Primary (light)",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "negative": {
          "displayName": "Negative",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "ink": {
          "displayName": "Text",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        },
        "muted": {
          "displayName": "Muted text",
          "type": {
            "fill": {
              "solid": {
                "color": true
              }
            }
          }
        }
      }
    },
    "heatmap": {
      "displayName": "Heatmap",
      "properties": {
        "indexMode": {
          "displayName": "Label as index (peak = 100)",
          "type": {
            "bool": true
          }
        },
        "showAll": {
          "displayName": "Show all values",
          "type": {
            "bool": true
          }
        },
        "lowLabel": {
          "displayName": "Legend low",
          "type": {
            "text": true
          }
        },
        "highLabel": {
          "displayName": "Legend high",
          "type": {
            "text": true
          }
        }
      }
    }
  },
  "privileges": [],
  "sorting": {
    "default": {}
  },
  "supportsHighlight": false,
  "supportsMultiVisualSelection": true,
  "suppressDefaultTitle": true
}