      {
        "name": "Orders",
        "columns": [
          {
            "name": "Order ID",
            "dataType": "string",
            "sourceColumn": "Order ID",
            "summarizeBy": "none"
          },
          {
            "name": "Order date",
            "dataType": "dateTime",
            "sourceColumn": "Order date",
            "summarizeBy": "none",
            "formatString": "yyyy-mm-dd",
            "isHidden": true
          },
          {
            "name": "Channel",
            "dataType": "string",
            "sourceColumn": "Channel",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Carrier",
            "dataType": "string",
            "sourceColumn": "Carrier",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Device",
            "dataType": "string",
            "sourceColumn": "Device",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Product",
            "dataType": "string",
            "sourceColumn": "Product",
            "summarizeBy": "none",
            "isHidden": true
          },
          {
            "name": "Quantity",
            "dataType": "int64",
            "sourceColumn": "Quantity",
            "summarizeBy": "sum"
          },
          {
            "name": "Order value",
            "dataType": "double",
            "sourceColumn": "Order value",
            "summarizeBy": "sum"
          },
          {
            "name": "Delivery days",
            "dataType": "double",
            "sourceColumn": "Delivery days",
            "summarizeBy": "sum"
          },
          {
            "name": "Minutes on site",
            "dataType": "double",
            "sourceColumn": "Minutes on site",
            "summarizeBy": "sum"
          }
        ],
        "partitions": [
          {
            "name": "Orders",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                "    // sample data embedded as base64 JSON, so refresh needs no files",
                "    Rows = Json.Document(Binary.FromText(\"\", BinaryEncoding.Base64)),",
                "    Source = Table.FromRows(Rows, {\"Order ID\", \"Order date\", \"Channel\", \"Carrier\", \"Device\", \"Product\", \"Quantity\", \"Order value\", \"Delivery days\", \"Minutes on site\"}),",
                "    Typed = Table.TransformColumnTypes(Source, {{\"Order ID\", type text}, {\"Order date\", type date}, {\"Channel\", type text}, {\"Carrier\", type text}, {\"Device\", type text}, {\"Product\", type text}, {\"Quantity\", Int64.Type}, {\"Order value\", type number}, {\"Delivery days\", type number}, {\"Minutes on site\", type number}})",
                "in",
                "    Typed"
              ]
            }
          }
        ],
        "measures": [
          {
            "name": "Sales",
            "expression": "SUM ( Orders[Order value] )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Profit",
            "expression": "SUMX ( Orders, Orders[Order value] * RELATED ( Product[Margin rate] ) )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Margin %",
            "expression": "DIVIDE ( [Profit], [Sales] )",
            "formatString": "0.0%"
          },
          {
            "name": "Order Count",
            "expression": "COUNTROWS ( Orders )",
            "formatString": "#,0"
          },
          {
            "name": "Units",
            "expression": "SUM ( Orders[Quantity] )",
            "formatString": "#,0"
          },
          {
            "name": "Avg Order Value",
            "expression": "DIVIDE ( [Sales], [Order Count] )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Days to Deliver",
            "expression": "SUM ( Orders[Delivery days] )",
            "formatString": "0.0"
          },
          {
            "name": "Avg Delivery Days",
            "expression": "AVERAGE ( Orders[Delivery days] )",
            "formatString": "0.0"
          },
          {
            "name": "Session Minutes",
            "expression": "SUM ( Orders[Minutes on site] )",
            "formatString": "0.0"
          },
          {
            "name": "Sales 2024",
            "expression": "CALCULATE ( [Sales], 'Date'[Year] = \"2024\" )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Sales 2025",
            "expression": "CALCULATE ( [Sales], 'Date'[Year] = \"2025\" )",
            "formatString": "\\$#,0"
          },
          {
            "name": "Sales Target",
            "expression": "[Sales 2024] * 1.12",
            "formatString": "\\$#,0"
          },
          {
            "name": "Margin Score",
            "expression": "[Margin %] * 100",
            "formatString": "0.0"
          }
        ]
      },
