                }
              },
              {
                "for": {
                  "in": "open"
                }
              },
              {
                "for": {
                  "in": "high"
                }
              },
              {
                "for": {
                  "in": "low"
                }
              },
              {
                "for": {
                  "in": "close"
                }
              },
              {
                "for": {
                  "in": "volume"
                }
              },
              {
                "for": {
                  "in": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 40
              }
            }
          }
        }
      }
    }
