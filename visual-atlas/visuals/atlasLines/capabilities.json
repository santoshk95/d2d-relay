{
  "dataRoles": [
    {
      "displayName": "X-axis",
      "displayNameKey": "Role_Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Usually dates or periods. Add a hierarchy, for example Year, Quarter and Month, to drill down.",
      "descriptionKey": "Role_Category_Desc"
    },
    {
      "displayName": "Legend",
      "displayNameKey": "Role_Series",
      "name": "series",
      "kind": "Grouping"
    },
    {
      "displayName": "Y-axis",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure",
      "description": "Lines and areas, or the columns of a combo chart.",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "displayName": "Line y-axis",
      "displayNameKey": "Role_Line",
      "name": "lineValues",
      "kind": "Measure",
      "description": "Combo charts: the measures drawn as lines.",
      "descriptionKey": "Role_Line_Desc"
    },
    {
      "displayName": "Lower bound",
      "displayNameKey": "Role_Lower",
      "name": "lower",
      "kind": "Measure",
      "description": "Optional. With Upper bound, a shaded error band around the first line.",
      "descriptionKey": "Role_Lower_Desc"
    },
    {
      "displayName": "Upper bound",
      "displayNameKey": "Role_Upper",
      "name": "upper",
      "kind": "Measure"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
