          "upper": {
            "max": 0
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 5000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "for": {
                  "in": "values"
                }
              },
              {
                "for": {
                  "in": "lineValues"
                }
              },
              {
                "for": {
                  "in": "lower"
                }
              },
              {
                "for": {
                  "in": "upper"
                }
              },
              {
                "for": {
                  "in": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 40
              }
            }
          }
        }
      }
    }
  ],
