{
  "dataRoles": [
    {
      "displayName": "Category",
      "displayNameKey": "Role_Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Columns of a Mekko, wedges of a rose or aster, waffle parts, icon rows, or Venn regions written as \"A & B\".",
      "descriptionKey": "Role_Category_Desc"
    },
    {
      "displayName": "Legend",
      "displayNameKey": "Role_Series",
      "name": "series",
      "kind": "Grouping",
      "description": "Optional. Segments of a Mekko column or stacked rose wedge.",
      "descriptionKey": "Role_Series_Desc"
    },
    {
      "displayName": "Values",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure",
      "description": "The value. A second measure is the total (waffle, pictogram) or the weight (aster).",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "sorting": {
    "default": {}
  },
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "series": {
            "max": 0
          }
        },
        {
          "category": {
            "max": 1
          },
          "series": {
            "max": 1
          },
          "values": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "for": {
                  "in": "values"
                }
              },
              {
                "for": {
                  "in": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 40
              }
            }
          }
        }
      }
    }
  ],
