{
  "dataRoles": [
    {
      "displayName": "Text",
      "displayNameKey": "Role_Text",
      "name": "category",
      "kind": "Grouping",
      "description": "Words, phrases or free text (comments, reviews). Free text is split into words.",
      "descriptionKey": "Role_Text_Desc"
    },
    {
      "displayName": "Topic",
      "displayNameKey": "Role_Group",
      "name": "group",
      "kind": "Grouping",
      "description": "Optional. Colors words by topic.",
      "descriptionKey": "Role_Group_Desc"
    },
    {
      "displayName": "Weight",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure",
      "description": "Optional. Sizes words (for example Mentions). Without it, words are sized by how often they appear.",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "displayName": "Color value",
      "displayNameKey": "Role_Color",
      "name": "colorValue",
      "kind": "Measure",
      "description": "Optional. Colors words on a gradient (for example Sentiment).",
      "descriptionKey": "Role_Color_Desc"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "group": {
            "max": 1
          },
          "values": {
            "max": 1
          },
          "colorValue": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "group"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 5000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "colorValue"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
