{
  "dataRoles": [
    {
      "displayName": "Category",
      "displayNameKey": "Role_Category",
      "name": "category",
      "kind": "Grouping",
      "description": "Optional. One card, gauge, ring or bullet per value (for example Region or Measure name).",
      "descriptionKey": "Role_Category_Desc"
    },
    {
      "displayName": "Trend axis",
      "displayNameKey": "Role_Trend",
      "name": "trend",
      "kind": "Grouping",
      "description": "Optional. A date or period for the KPI sparkline; the latest period is the value shown.",
      "descriptionKey": "Role_Trend_Desc"
    },
    {
      "displayName": "Value",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure",
      "description": "The value. Several measures without a Category make one card each.",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "displayName": "Target",
      "displayNameKey": "Role_Target",
      "name": "target",
      "kind": "Measure"
    },
    {
      "displayName": "Minimum",
      "displayNameKey": "Role_Min",
      "name": "minValue",
      "kind": "Measure"
    },
    {
      "displayName": "Maximum",
      "displayNameKey": "Role_Max",
      "name": "maxValue",
      "kind": "Measure"
    },
    {
      "displayName": "Band 1 (poor to fair)",
      "displayNameKey": "Role_Band1",
      "name": "band1",
      "kind": "Measure"
    },
    {
      "displayName": "Band 2 (fair to good)",
      "displayNameKey": "Role_Band2",
      "name": "band2",
      "kind": "Measure"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "trend": {
            "max": 1
          },
          "target": {
            "max": 1
          },
          "minValue": {
            "max": 1
          },
          "maxValue": {
            "max": 1
          },
          "band1": {
            "max": 1
          },
          "band2": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "trend"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 10000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "target"
              }
            },
            {
              "for": {
                "in": "minValue"
              }
            },
            {
              "for": {
                "in": "maxValue"
              }
            },
            {
              "for": {
                "in": "band1"
              }
            },
            {
              "for": {
                "in": "band2"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
