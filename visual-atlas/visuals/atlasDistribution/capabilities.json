{
  "dataRoles": [
    {
      "displayName": "Group",
      "displayNameKey": "Role_Group",
      "name": "category",
      "kind": "Grouping",
      "description": "Optional. One box, violin or histogram color per value, for example Carrier or Channel.",
      "descriptionKey": "Role_Group_Desc"
    },
    {
      "displayName": "Sample by",
      "displayNameKey": "Role_Detail",
      "name": "detail",
      "kind": "Grouping",
      "description": "The field that identifies one observation, for example Order ID or Shipment ID. Each row becomes one data point.",
      "descriptionKey": "Role_Detail_Desc"
    },
    {
      "displayName": "Values",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure",
      "description": "The value to describe. Parallel coordinates draws one axis per measure.",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "detail": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "category"
              }
            },
            {
              "for": {
                "in": "detail"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "select": [
            {
              "for": {
                "in": "values"
              }
            },
            {
              "for": {
                "in": "tooltips"
              }
            }
          ]
        }
      }
    }
  ],
