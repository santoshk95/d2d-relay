{
  "dataRoles": [
    {
      "displayName": "Category",
      "displayNameKey": "Role_Category",
      "name": "category",
      "kind": "Grouping",
      "description": "The items to compare (rows of a lollipop or dumbbell, spokes of a radar, periods of a bump chart).",
      "descriptionKey": "Role_Category_Desc"
    },
    {
      "displayName": "Legend",
      "displayNameKey": "Role_Series",
      "name": "series",
      "kind": "Grouping",
      "description": "Optional. Splits the values into series (periods for a slope chart, items for a bump chart, lines on a radar).",
      "descriptionKey": "Role_Series_Desc"
    },
    {
      "displayName": "Values",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure",
      "description": "One measure, or several (for example Sales 2024 and Sales 2025 for a dumbbell).",
      "descriptionKey": "Role_Values_Desc"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "sorting": {
    "default": {}
  },
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "series": {
            "max": 0
          }
        },
        {
          "category": {
            "max": 1
          },
          "series": {
            "max": 1
          },
          "values": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 3000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "for": {
                  "in": "values"
                }
              },
              {
                "for": {
                  "in": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 60
              }
            }
          }
        }
      }
    }
  ],
