{
  "dataRoles": [
    {
      "displayName": "Legend",
      "displayNameKey": "Role_Category",
      "name": "category",
      "kind": "Grouping",
      "description": "The slices. Add a hierarchy, for example Category and Subcategory, to drill down.",
      "descriptionKey": "Role_Category_Desc"
    },
    {
      "displayName": "Details",
      "displayNameKey": "Role_Series",
      "name": "series",
      "kind": "Grouping",
      "description": "Optional. Splits each slice into an outer ring.",
      "descriptionKey": "Role_Series_Desc"
    },
    {
      "displayName": "Values",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "drilldown": {
    "roles": [
      "category"
    ],
    "canDisableDrill": {
      "disabledByDefault": false
    }
  },
  "sorting": {
    "default": {}
  },
  "dataViewMappings": [
    {
      "conditions": [
        {
          "category": {
            "max": 1
          },
          "series": {
            "max": 0
          }
        },
        {
          "category": {
            "max": 1
          },
          "series": {
            "max": 1
          },
          "values": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "for": {
            "in": "category"
          },
          "dataReductionAlgorithm": {
            "top": {
              "count": 1000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "for": {
                  "in": "values"
                }
              },
              {
                "for": {
                  "in": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 30
              }
            }
          }
        }
      }
    }
  ],
