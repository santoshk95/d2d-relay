{
  "dataRoles": [
    {
      "displayName": "Time",
      "displayNameKey": "Role_Time",
      "name": "time",
      "kind": "Grouping",
      "description": "A date (calendar, timeline slicer), the x-axis of a stream graph, or the columns of a heat grid (for example Hour).",
      "descriptionKey": "Role_Time_Desc"
    },
    {
      "displayName": "Rows",
      "displayNameKey": "Role_Rows",
      "name": "rows",
      "kind": "Grouping",
      "description": "Heat grid and punch card: the rows (for example Weekday).",
      "descriptionKey": "Role_Rows_Desc"
    },
    {
      "displayName": "Legend",
      "displayNameKey": "Role_Series",
      "name": "series",
      "kind": "Grouping",
      "description": "Stream graph: one stream per value.",
      "descriptionKey": "Role_Series_Desc"
    },
    {
      "displayName": "Values",
      "displayNameKey": "Role_Values",
      "name": "values",
      "kind": "Measure"
    },
    {
      "displayName": "Tooltips",
      "displayNameKey": "Role_Tooltips",
      "name": "tooltips",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        {
          "time": {
            "max": 1
          },
          "rows": {
            "max": 1
          },
          "series": {
            "max": 1
          },
          "values": {
            "max": 1
          }
        }
      ],
      "categorical": {
        "categories": {
          "select": [
            {
              "for": {
                "in": "time"
              }
            },
            {
              "for": {
                "in": "rows"
              }
            }
          ],
          "dataReductionAlgorithm": {
            "top": {
              "count": 30000
            }
          }
        },
        "values": {
          "group": {
            "by": "series",
            "select": [
              {
                "for": {
                  "in": "values"
                }
              },
              {
                "for": {
                  "in": "tooltips"
                }
              }
            ],
            "dataReductionAlgorithm": {
              "top": {
                "count": 30
              }
            }
          }
        }
      }
    }
  ],
