# D2D Relay: sign-in with a one-time email code for business addresses; each email domain is an organisation with its
# own workspace and credits (webapp/app/otp.py, orgs.py, docs/d2d-relay.md). Free and disposable mail is refused.
# The code is emailed from RELAY_OTP_FROM through Microsoft Graph: a public-client Entra app with DELEGATED Mail.Send;
# that mailbox signs in once with a device code (python -m app.otp_mail login, see docs/d2d-relay.md).
# RELAY_OTP_EMAIL: the owner of the platform's own workspace (PASDACS). Every organisation, credits and connectors are
# on the admin portal, for every RELAY_ADMIN_DOMAINS address (below).
RELAY_OTP_EMAIL=info@pasdacs.com
RELAY_OTP_FROM=info@pasdacs.com
RELAY_OTP_MS_TENANT=
RELAY_OTP_MS_CLIENT_ID=
# Only if your tenant allows client secrets (app-only sending); leave empty otherwise:
RELAY_OTP_MS_CLIENT_SECRET=
# Credits per organisation (empty = the defaults: 50 to start, 25 a new dashboard, 10 a change, 10 for up to 5 Ask
# Relay questions in a conversation; PASDACS approves every request for more) and where "Request credits" emails go.
# RELAY_CREDITS_START_REVIEW: empty or 1 = a new organisation's starting credits wait until PASDACS approves them
# (PASDACS is emailed about every new organisation; admin portal, Requests); 0 = they are added at sign-up
RELAY_CREDITS_START=
RELAY_CREDITS_START_REVIEW=
RELAY_CREDITS_DASHBOARD=
RELAY_CREDITS_CHANGE=
RELAY_CREDITS_ASK=
RELAY_CREDITS_ASK_QUESTIONS=
RELAY_CREDITS_CONTACT=info@pasdacs.com
# Buying credits online with Razorpay (docs/d2d-relay.md, "Payments"): the API keys from the Razorpay Dashboard
# (Account & Settings, API keys) and the secret you type when adding the webhook there. Test keys (rzp_test_...) move
# no money: with them only PASDACS's own workspace can buy. The packs, prices and switching selling on are on the
# admin portal (Payments). Secrets: in .env only, never in commits.
RELAY_RAZORPAY_KEY_ID=
RELAY_RAZORPAY_KEY_SECRET=
RELAY_RAZORPAY_WEBHOOK_SECRET=
# An email to PASDACS on every sign-in (docs/d2d-relay.md, "Sign-in alerts"): 0 = off; where they go (empty = the
# credits contact above)
RELAY_SIGNIN_ALERTS=
RELAY_SIGNIN_ALERTS_TO=
# A bot check before a sign-in code is emailed (docs/d2d-relay.md, "Bot check"): Cloudflare Turnstile's site key and
# secret key for this site's hostname (Cloudflare dashboard, Turnstile, Add widget). Both empty = no check. The secret
# is a secret: .env only, never in commits.
RELAY_TURNSTILE_SITE_KEY=
RELAY_TURNSTILE_SECRET=
# The AI's Anthropic API key (docs/d2d-relay.md, "The AI's Claude account"): set, every AI run uses it first and the
# Claude subscription the AI engine is signed in with becomes the backup (it answers once when the API fails: key,
# credit, rate limit, outage). Empty = the subscription only. Never name it ANTHROPIC_API_KEY here: the AI engine
# would then use it for every run and the backup could not work. A secret: .env only, never in commits.
RELAY_ANTHROPIC_API_KEY=
# How long records are kept (docs/d2d-relay.md, "Data governance"), in days: the audit trail, sign-in records and
# sign-in codes (365: India's DPDP Rules ask for at least a year), Ask Relay's answer cache (7), database dumps and
# exports made by hand in data/backups (30)
RELAY_LOG_KEEP_DAYS=
RELAY_ASKD_CACHE_DAYS=
RELAY_DUMP_KEEP_DAYS=
# More email domains to refuse, or listed ones to accept (comma-separated)
RELAY_PUBLIC_DOMAINS_EXTRA=
RELAY_PUBLIC_DOMAINS_ALLOW=

# RELAY by PASDACS: settings for the one container (docker-compose.yml). Copy to .env and fill in what you need;
# anything left empty keeps its default. Guide: docs/single-container.md.
# (The one-container-per-part development stack reads the older D2D_* names: docker-compose.dev.yml.)

# --- Image and folders on this PC ------------------------------------------------------------------------------------
RELAY_VERSION=1.0.0
# Where the projects, backups and visual library live on this PC (Power BI Desktop and the DAX checker use the
# projects folder). Defaults: ./data/projects, ./data/backups, ./data/library
RELAY_PROJECTS=
RELAY_BACKUPS=
RELAY_LIBRARY=
# The same projects and library folders as full Windows paths (shown in the app, and the Power BI DataFolder)
HOST_PROJECTS_DIR=
HOST_LIBRARY_DIR=

# --- Network ---------------------------------------------------------------------------------------------------------
# Relay is on http://127.0.0.1:<port>. RELAY_LAN_IP also publishes it on that address of this PC (relay.cmd start adds
# it only when the address is here right now).
RELAY_PORT=8100
RELAY_LAN_IP=
# The address people use to reach Relay, for links in emails and shares (e.g. https://relay.example.com)
RELAY_PUBLIC_URL=https://d2d.pasdacs.com

# --- Sign-in ---------------------------------------------------------------------------------------------------------
# single = one local user, no sign-in (a demo on one PC) | sso = sign-in with your identity provider (set it up on
# Admin > Sign-in) | header = a proxy in front signs people in
RELAY_AUTH=otp
RELAY_ADMIN_EMAIL=info@pasdacs.com
RELAY_ADMIN_NAME=
# The first admin's password for sign-in with sso (before the identity provider is set up)
RELAY_ADMIN_PASSWORD=
RELAY_SESSION_HOURS=
# Encrypts saved credentials. Empty = a key made on the first start and kept in the data volume.
RELAY_SECRET_KEY=

# --- AI engine -------------------------------------------------------------------------------------------------------
# The Claude sign-in: a Docker volume (relay login fills it). To reuse an existing sign-in volume, name it and set
# RELAY_CLAUDE_EXTERNAL=true. The Antigravity CLI's Google sign-in works the same way.
RELAY_CLAUDE_VOLUME=d2d-relay-claude-login
RELAY_CLAUDE_EXTERNAL=false
RELAY_AGY_VOLUME=relay-agy-login
RELAY_AGY_EXTERNAL=false
# The default model for new dashboards (admins can change it per project). Empty = the default in config/models.json
RELAY_AGENT_MODEL=
# 1 = a failure with no known fix starts an AI diagnosis by itself (AI cost); 0 = a person clicks Diagnose
HEAL_AUTO_DIAGNOSE=0
# The AI gateway for Amazon Bedrock, Azure AI Foundry and Google Vertex AI: auto = on once such a provider is set up
RELAY_GATEWAY=auto
# Build only: copy the Antigravity CLI from this image instead of downloading the latest (keeps a tested version)
RELAY_AGY_IMAGE=

# --- Database --------------------------------------------------------------------------------------------------------
# D2D Relay: the database container (d2d-relay-db) lets the public site and the admin portal sign in with this
# password over the private Docker network. Required. Make one (letters and digits only, it goes into a URL):
#   python -c "import secrets; print(secrets.token_hex(24))"
RELAY_DB_PASSWORD=
# true when the database volume d2d-relay-db-data was made outside compose (docker\move-to-split.ps1 sets it)
RELAY_DB_EXTERNAL=
# (One container with everything inside instead, as before the split: RELAY_ROLE=all. Not used by docker-compose.yml.)
RELAY_DATABASE=postgres
RELAY_DATABASE_URL=

# --- Admin portal (d2d-relay-admin, docs/d2d-relay.md "Admin portal") -----------------------------------------------------
# PASDACS only: Cloudflare Access in front of it, then the app's own email code for these domains (comma-separated).
RELAY_ADMIN_DOMAINS=pasdacs.com
# Optional (security audit S10): only these addresses (comma-separated) are platform admins, instead of the whole domain.
# Name the same addresses in the Cloudflare Access policy.
RELAY_ADMIN_EMAILS=

# --- The AI engine's network (security audit S6, docs/d2d-relay.md "What the AI can reach") ---------------------------------
# on (default): it reaches only Anthropic, through a proxy in the web container; off: as before 2026-11-12.
RELAY_AGENT_EGRESS=on
# The hosts the proxy allows (port 443), comma-separated; empty = Anthropic's API and sign-in hosts.
RELAY_AGENT_EGRESS_ALLOW=
# Each AI build in a container of its own (item 31, the job runner d2d-relay-runner): auto (when the runner runs),
# on, or off (builds run inside the web container's AI engine, as before 2026-11-12).
RELAY_JOB_CONTAINERS=auto
RELAY_ADMIN_PORT=8102
RELAY_ADMIN_PUBLIC_URL=https://admin-d2d.pasdacs.com
# From Cloudflare Zero Trust: the team name (<team>.cloudflareaccess.com) and the Access application's AUD tag.
# Until both are set, the admin portal refuses everything that comes through the tunnel (this PC only).
RELAY_ADMIN_ACCESS_TEAM=
RELAY_ADMIN_ACCESS_AUD=

# --- Operations ------------------------------------------------------------------------------------------------------
# GET /metrics for a Prometheus scraper (empty = off)
RELAY_METRICS_TOKEN=
# The app's own backups (database copy + project folders) into the backups folder: hour (UTC) and how many to keep
RELAY_BACKUP_HOUR_UTC=
RELAY_BACKUP_KEEP=
TZ=UTC

# --- Mail and webhooks -----------------------------------------------------------------------------------------------
RELAY_WEBHOOK_HOSTS=
RELAY_GMAIL_SMTP=
RELAY_GMAIL_SMTP_PORT=
