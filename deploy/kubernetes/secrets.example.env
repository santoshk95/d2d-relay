# Copy to <overlay>/secrets.env and fill in. Never commit the filled-in file.
postgres-password=change-me
database-url=postgresql://d2d:change-me@postgres:5432/d2d
# encrypts the secrets store (warehouse logins, email, GitHub): `python -c "import secrets;print(secrets.token_urlsafe(32))"`
secret-key=
# the first Admin's password for sign-in before SSO is set up
admin-password=
# GET /metrics for Prometheus (empty = off)
metrics-token=
# optional: the shared agent's Claude login (`claude setup-token`)
claude-oauth-token=
